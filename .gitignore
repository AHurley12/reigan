node_modules/
dist/
out/
.env
*.db
.DS_Store
*.tsbuildinfo

# 171MB of third-party GLB avatar models. Binary assets this size do not
# belong in git history without LFS — committing them is irreversible repo
# bloat, and two of the three are near GitHub per-file limits. Set up Git LFS
# if these need to be versioned.
src/renderer/public/models/

# Agent worktrees are separate checkouts of this repo — never a submodule of it.
.claude/worktrees/

# Isolated Electron profile for dev runs — keeps test migrations out of the real DB.
.devdata/

# SQLite sidecars. `*.db` above does not match these — the WAL and shared-memory
# files carry a suffix, so they slipped through and were committed on the
# devtools branch (a 1.4MB WAL). They hold uncheckpointed page data from a
# developer's local database and are meaningless in version control.
*.db-wal
*.db-shm
*.db-journal
